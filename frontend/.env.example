# Frontend environment variables (Vite). Copy to .env for local development.

# Local development (recommended): use the dev-server proxy from vite.config.js.
VITE_API_BASE_URL=/api

# Production: set this to the deployed backend API base URL on your static host
# (Vercel / Netlify / Render Static Site -> Environment Variables).
# Example:
# VITE_API_BASE_URL=https://mohanasundaram12345-hotel-booking-v844.onrender.com/api
