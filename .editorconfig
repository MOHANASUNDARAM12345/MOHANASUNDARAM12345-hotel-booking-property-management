# EditorConfig: consistent style across all editors
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.{js,jsx,ts,tsx,json,yml,yaml,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[{package-lock.json,composer.lock}]
indent_size = 2
insert_final_newline = false

[*.{sh,ps1}]
end_of_line = lf