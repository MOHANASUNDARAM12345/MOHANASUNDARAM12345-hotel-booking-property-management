# Copy this file to backend/backend/.env (gitignored) and fill in real values.
# Spring Boot loads it automatically via spring.config.import in application.properties.

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/hotel_booking_db
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password

# JWT signing secret (use a long random value in production)
JWT_SECRET=replace-with-a-strong-random-secret

# CORS allowlist (comma separated). Include every frontend origin that calls the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
# Optional wildcard patterns (e.g. preview deployments)
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app,https://*.netlify.app,https://*.onrender.com
